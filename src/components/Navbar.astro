---
---
<header class="sticky top-0 z-50 w-full bg-white/90 backdrop-blur-md border-b border-slate-100 shadow-xs">
    <!-- Barra superior institucional -->
    <div class="bg-upc-dark text-white text-xs py-1.5 px-4 sm:px-8">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
        <div class="flex items-center gap-4">
            <span class="hidden md:inline">
                <img src="/assets/icons/pin.svg" alt="Pin" class="w-4 h-4" />
            </span>
            <span>Carretera Villahermosa - Teapa Km. 22.5, Tumbulushal</span>
            <span class="hidden md:inline">|</span>
            <span class="hidden md:inline">
                <img src="/assets/icons/call.svg" alt="Call" class="w-4 h-4" />
            </span>
            <span class="hidden md:inline">993 312 5893</span>
        </div>
        <div class="flex items-center gap-4">
            <!-- Enlace a Facebook con ícono SVG -->
            <a 
                href="https://facebook.com/universidadpolitecnicadelcentro" 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-slate-300 hover:text-amber-300 transition-colors p-2 rounded-lg hover:bg-white/5 flex items-center"
                aria-label="Facebook Oficial"
            >
                <img src="/assets/icons/facebook.svg" alt="Facebook" class="w-4 h-4" />
            </a>

            <!-- Enlace a Instagram con ícono SVG -->
            <a 
                href="https://instagram.com/upctabasco/" 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-slate-300 hover:text-amber-300 transition-colors p-2 rounded-lg hover:bg-white/5 flex items-center"
                aria-label="Instagram Oficial"
            >
                <img src="/assets/icons/instagram.svg" alt="Instagram" class="w-4 h-4" />
            </a>
        </div>
        </div>
    </div>

    <!-- Barra de navegación principal -->
    <nav class="max-w-7xl mx-auto px-4 sm:px-8 py-3 flex items-center justify-between">
        <!-- Logotipo institucional -->
        <a href="/" class="flex items-center gap-3 group">
            <div class="h-10 w-auto flex items-center group-hover:scale-105 transition-transform">
                <img src="/assets/logo/upc.png" alt="Universidad Politécnica del Centro" class="h-full w-auto object-contain" />
            </div>
            <div class="leading-tight">
                <span class="block font-bold text-sm sm:text-base text-slate-900 tracking-tight">Universidad Politécnica</span>
                <span class="block text-xs text-slate-500 font-medium">del Centro</span>
            </div>
        </a>

        <!-- Enlaces de navegación desktop -->
        <div class="hidden lg:flex items-center gap-7 font-medium text-sm text-slate-700">
            <a href="/" class="text-upc-primary font-semibold transition-colors">Inicio</a>
            <a href="/identidad" class="hover:text-upc-primary transition-colors">Identidad</a>
            <a href="/carreras" class="hover:text-upc-primary transition-colors">Carreras</a>
            <a href="/calendario" class="hover:text-upc-primary transition-colors">Calendario</a>
            <a href="#boletines" class="hover:text-upc-primary transition-colors">Boletines</a>
        </div>

        <!-- Botones de acceso rápido a plataformas -->
        <div class="hidden sm:flex items-center gap-3">
            <a href="http://200.94.123.67/Modulos/Seguridad/Vistas/Login.aspx" target="_blank" class="text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 px-3.5 py-2 rounded-lg transition-colors">
                SIUPC
            </a>
            <a href="http://200.94.123.70/" target="_blank" class="text-xs font-semibold bg-upc-primary hover:bg-upc-dark text-white px-4 py-2 rounded-lg shadow-xs transition-all">
                Moodle
            </a>
        </div>
    </nav>
</header>