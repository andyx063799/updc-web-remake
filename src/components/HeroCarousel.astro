---
// Array de imágenes y textos institucionales para el carrusel
const slides = [
    {
        image: "/assets/images/image_1.jpg",
        title: "Innovación, Ciencia y Tecnología al Servicio de la Sociedad",
        subtitle: "Formando ingenieros y profesionales altamente competitivos en Tabasco."
    },
    {
        image: "/assets/images/image_2.jpg",
        title: "Nueva Convocatoria de Admisión Abierta",
        subtitle: "Inicia tu proceso de registro para el Cuatrimestre Enero - Abril 2027."
    },
    {
        image: "/assets/images/image_3.jpg",
        title: "Infraestructura Moderna y Educación de Calidad",
        subtitle: "Espacios diseñados para potenciar tu desarrollo académico y profesional."
    }
];
---

<section class="relative w-full h-145 sm:h-160 overflow-hidden bg-slate-900">
    <!-- Contenedor del Carrusel -->
    <div id="hero-carousel" class="absolute inset-0 w-full h-full">
        {slides.map((slide, index) => (
        <div 
            class={`carousel-slide absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
            data-index={index}
        >
            <!-- Imagen de fondo con overlay oscuro degradado -->
            <img src={slide.image} alt={slide.title} class="w-full h-full object-cover object-center scale-105 animate-subtle-zoom" />
            <div class="absolute inset-0 bg-linear-to-r from-black/80 via-black/50 to-transparent"></div>
            
            <!-- Contenido del Slide -->
            <div class="absolute inset-0 max-w-7xl mx-auto px-6 sm:px-8 flex flex-col justify-center items-start text-white pb-24 sm:pb-28">
            <span class="inline-block bg-upc-primary text-white text-xs font-bold px-3 py-1 rounded-md uppercase tracking-wider mb-4 shadow-md">
                Universidad Politécnica del Centro
            </span>
            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold max-w-3xl leading-tight mb-4 tracking-tight text-balance">
                {slide.title}
            </h1>
            <p class="text-base sm:text-lg text-slate-200 max-w-xl mb-8 font-normal leading-relaxed">
                {slide.subtitle}
            </p>
            <div class="flex flex-wrap gap-4">
                <a href="#admision" class="bg-upc-primary hover:bg-upc-dark text-white font-bold px-6 py-3.5 rounded-xl shadow-lg transition-all hover:scale-105">
                Proceso de Admisión 2027
                </a>
                <!-- Cambiado de #carreras a la página independiente /carreras -->
                <a href="/carreras" class="bg-white/10 hover:bg-white/20 backdrop-blur-md text-white font-semibold px-6 py-3.5 rounded-xl border border-white/20 transition-all">
                Ver Oferta Educativa
                </a>
            </div>
            </div>
        </div>
        ))}
    </div>

    <!-- Controles de navegación del carrusel (Puntos indicadores) -->
    <div class="absolute bottom-6 right-8 z-30 flex items-center gap-2">
        {slides.map((_, index) => (
        <button 
            class={`carousel-dot w-3 h-3 rounded-full transition-all ${index === 0 ? 'bg-white w-8' : 'bg-white/50 hover:bg-white/80'}`}
            data-index={index}
            aria-label={`Ir al slide ${index + 1}`}
        ></button>
        ))}
    </div>
</section>

<style>
    @keyframes subtleZoom {
        0% { transform: scale(1); }
        100% { transform: scale(1.06); }
    }
    .animate-subtle-zoom {
        animation: subtleZoom 8s infinite alternate ease-in-out;
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('.carousel-slide');
    const dots = document.querySelectorAll('.carousel-dot');
    let currentIndex = 0;
    const totalSlides = slides.length;
    let intervalId: any;

    function showSlide(index: number) {
        slides.forEach((slide, i) => {
            if (i === index) {
                slide.classList.remove('opacity-0', 'z-0');
                slide.classList.add('opacity-100', 'z-10');
            } else {
                slide.classList.remove('opacity-100', 'z-10');
                slide.classList.add('opacity-0', 'z-0');
            }
        });

        dots.forEach((dot, i) => {
            if (i === index) {
                dot.classList.remove('bg-white/50');
                dot.classList.add('bg-white', 'w-8');
            } else {
                dot.classList.remove('bg-white', 'w-8');
                dot.classList.add('bg-white/50');
            }
        });
        currentIndex = index;
    }

    function nextSlide() {
        let next = (currentIndex + 1) % totalSlides;
        showSlide(next);
    }

    function startTimer() {
        intervalId = setInterval(nextSlide, 6000);
    }

    startTimer();

    dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
            clearInterval(intervalId);
            showSlide(index);
            startTimer();
        });
    });
});
</script>